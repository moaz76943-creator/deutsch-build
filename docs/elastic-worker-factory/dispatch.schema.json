{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DEUTSCH Elastic Worker Dispatch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "program_id",
    "task_id",
    "worker_id",
    "worker_class",
    "owner",
    "base_sha",
    "scope_fingerprint",
    "dependencies",
    "acceptance",
    "budget_class",
    "evidence_target",
    "next_action",
    "priority",
    "central_admitted",
    "dispatch_schema_version",
    "worker_profile_version",
    "contract_version_or_hash",
    "toolchain_or_validator_version",
    "input_revision",
    "output_evidence_revision"
  ],
  "properties": {
    "program_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "worker_id": {
      "type": "string",
      "minLength": 1
    },
    "worker_class": {
      "enum": [
        "DETERMINISTIC_READ_ONLY",
        "AI_READ_ONLY",
        "MUTATION"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "mutable_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "read_only_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "scope_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "budget_class": {
      "enum": [
        "FREE_DETERMINISTIC_LOW",
        "FREE_DETERMINISTIC_STANDARD",
        "EXISTING_PLAN_AI_READ_ONLY",
        "EXISTING_GITHUB_ACTIONS"
      ]
    },
    "evidence_target": {
      "type": "string",
      "minLength": 1
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    },
    "priority": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3",
        "P4"
      ]
    },
    "central_admitted": {
      "type": "boolean"
    },
    "dispatch_schema_version": {
      "const": "1.0"
    },
    "worker_profile_version": {
      "const": "1.0"
    },
    "contract_version_or_hash": {
      "type": "string",
      "minLength": 1
    },
    "toolchain_or_validator_version": {
      "type": "string",
      "minLength": 1
    },
    "input_revision": {
      "type": "string",
      "minLength": 1
    },
    "output_evidence_revision": {
      "type": "string",
      "minLength": 1
    }
  },
  "oneOf": [
    {
      "required": [
        "mutable_scope"
      ],
      "not": {
        "required": [
          "read_only_scope"
        ]
      }
    },
    {
      "required": [
        "read_only_scope"
      ],
      "not": {
        "required": [
          "mutable_scope"
        ]
      }
    }
  ]
}
