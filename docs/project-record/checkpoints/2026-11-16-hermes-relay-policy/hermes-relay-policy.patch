From a232b6aa6406da515a7f1ae3cd50786ea6d6639c Mon Sep 17 00:00:00 2001
From: Hermes Agent <hermes-agent@nousresearch.local>
Date: Mon, 16 Nov 2026 03:06:03 +0000
Subject: [PATCH] ci: classify hermes-relay workflow under zero-billing D
 policy

hermes-relay.yml (added in d7cc05b75) was active but unclassified in the
zero-billing/supply-chain gates and used a mutable actions/checkout ref.
Pin checkout to immutable SHA 11d5960a... (v4, repo convention), classify
as D_AUTOMATIC_OPT_IN with job-level NONESSENTIAL_AUTOMATION_ENABLED gate,
and bump active-workflow count 34 -> 35.

Note: relay hops now allocate hosted runners only when repo variable
GITHUB_ACTIONS_NONESSENTIAL_AUTOMATION_ENABLED == 'true' (fail-closed).

tests/quality_gate: 28F/140P -> 25F/143P (3 fixed, zero new failures);
remaining 25 are pre-existing task6b/6c/6d/7/11 feature-contract baseline
debt. registry_sync --check exit 0.
---
 .github/workflows/hermes-relay.yml                        | 4 +++-
 tests/quality_gate/test_current_topology_security_gate.py | 3 ++-
 tests/quality_gate/test_zero_billing_actions_policy.py    | 1 +
 3 files changed, 6 insertions(+), 2 deletions(-)

diff --git a/.github/workflows/hermes-relay.yml b/.github/workflows/hermes-relay.yml
index 6f9092aaf..251afe558 100644
--- a/.github/workflows/hermes-relay.yml
+++ b/.github/workflows/hermes-relay.yml
@@ -20,11 +20,13 @@ concurrency:
 
 jobs:
   run-agent:
+    if: >-
+      vars.GITHUB_ACTIONS_NONESSENTIAL_AUTOMATION_ENABLED == 'true'
     runs-on: ubuntu-latest
     timeout-minutes: 330
     steps:
       - name: سحب الكود
-        uses: actions/checkout@v4
+        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
         with:
           fetch-depth: 0
 
diff --git a/tests/quality_gate/test_current_topology_security_gate.py b/tests/quality_gate/test_current_topology_security_gate.py
index 73f9fc13b..2ec71638d 100644
--- a/tests/quality_gate/test_current_topology_security_gate.py
+++ b/tests/quality_gate/test_current_topology_security_gate.py
@@ -44,6 +44,7 @@ WORKFLOW_CLASS = {
     "cleanup_old_artifacts.yml": D_AUTOMATIC_OPT_IN,
     "content_expansion_bot.yml": D_AUTOMATIC_OPT_IN,
     "elastic-worker-factory.yml": B_MANUAL_UTILITY,
+    "hermes-relay.yml": D_AUTOMATIC_OPT_IN,
     "language_registry_guard.yml": "F",
     "local_release.yml": C_SELF_HOSTED,
     "performance_guard.yml": D_AUTOMATIC_OPT_IN,
@@ -323,7 +324,7 @@ def test_all_active_workflows_obey_current_zero_billing_and_supply_chain_policy(
     assert_active_build_delivery_boundaries()
     workflows = active_workflows()
     assert set(workflows) == set(WORKFLOW_CLASS)
-    assert len(workflows) == 34
+    assert len(workflows) == 35
 
     for name, workflow in workflows.items():
         category = WORKFLOW_CLASS[name]
diff --git a/tests/quality_gate/test_zero_billing_actions_policy.py b/tests/quality_gate/test_zero_billing_actions_policy.py
index 09e17bab9..25f078f88 100644
--- a/tests/quality_gate/test_zero_billing_actions_policy.py
+++ b/tests/quality_gate/test_zero_billing_actions_policy.py
@@ -35,6 +35,7 @@ WORKFLOW_CLASSIFICATION = {
     "cleanup_old_artifacts.yml": D_AUTOMATIC_OPT_IN,
     "content_expansion_bot.yml": D_AUTOMATIC_OPT_IN,
     "elastic-worker-factory.yml": B_MANUAL_UTILITY,
+    "hermes-relay.yml": D_AUTOMATIC_OPT_IN,
     "language_registry_guard.yml": F_BUDGETED_SELF_CHECK,
     "local_release.yml": C_SELF_HOSTED,
     "performance_guard.yml": D_AUTOMATIC_OPT_IN,
-- 
