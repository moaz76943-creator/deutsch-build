import 'package:shared_preferences/shared_preferences.dart';

class BadgeEngine {
  static const String _badgePrefix = 'unlocked_badge_';

  // التحقق من منح وسام معين وتخزينه محلياً لمنع التكرار
  static Future<bool> checkAndAwardBadge(String badgeId, String title) async {
    final prefs = await SharedPreferences.getInstance();
    final key = '$_badgePrefix$badgeId';
    
    if (prefs.getBoolean(key) ?? false) {
      return false; // الوسام مנוح مسبقاً
    }

    // منح الوسام وتسجيله مع طابع زمني دقيق
    await prefs.setBool(key, true);
    await prefs.setInt('${key}_timestamp', DateTime.now().millisecondsSinceEpoch);
    return true; // تم منح وسام جديد بنجاح
  }

  // جلب كافة الأوسمة المحصلة محلياً
  static Future<List<Map<String, dynamic>>> getUnlockedBadges() async {
    final prefs = await SharedPreferences.getInstance();
    final keys = prefs.getKeys();
    List<Map<String, dynamic>> badges = [];

    for (var key in keys) {
      if (key.startsWith(_badgePrefix) && !key.endsWith('_timestamp')) {
        String badgeId = key.replaceFirst(_badgePrefix, '');
        int timestamp = prefs.getInt('${key}_timestamp') ?? 0;
        badges.add({
          'badgeId': badgeId,
          'unlockedAt': timestamp,
        });
      }
    }
    return badges;
  }
}
