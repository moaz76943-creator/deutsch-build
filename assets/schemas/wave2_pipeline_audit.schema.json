{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deutsch-bilarabi.local/assets/schemas/wave2_pipeline_audit.schema.json",
  "title": "Wave 2 content pipeline audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "wave",
    "languages",
    "admissionState",
    "expectedPipelineResult",
    "validation",
    "quarantineReason",
    "sourceSha256",
    "executionEvidence",
    "promotionBlockers"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "wave": {
      "type": "integer",
      "const": 2
    },
    "languages": {
      "type": "array",
      "const": [
        "es",
        "fr",
        "it",
        "pt",
        "nl"
      ]
    },
    "admissionState": {
      "type": "string",
      "enum": [
        "CANDIDATE_ONLY",
        "CANONICAL_READY"
      ]
    },
    "policy": {
      "type": "string"
    },
    "expectedPipelineResult": {
      "type": "object"
    },
    "validation": {
      "type": "object"
    },
    "quarantineReason": {
      "type": "string"
    },
    "sourceSha256": {
      "type": "object"
    },
    "executionEvidence": {
      "type": "object"
    },
    "promotionBlockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
