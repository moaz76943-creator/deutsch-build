{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "assets/schemas/phase18_content_review_metadata.schema.json",
  "title": "Phase 18 Content Review Metadata",
  "description": "Optional metadata consumed by the offline canonical content gate. Omitted review fields fall back to deterministic structural and semantic checks.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "semanticConfidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "culturalRisk": {
      "type": "string",
      "enum": [
        "none",
        "low",
        "medium",
        "high"
      ]
    },
    "culturalReview": {
      "type": "string",
      "enum": [
        "not-required",
        "approved",
        "required",
        "pending",
        "needs-review"
      ]
    },
    "reviewStatus": {
      "type": "string",
      "enum": [
        "approved",
        "verified",
        "pending",
        "needs-review",
        "rejected"
      ]
    }
  }
}
