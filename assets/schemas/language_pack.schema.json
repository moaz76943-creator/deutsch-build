{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deutsch-bilarabi.local/assets/schemas/language_pack.schema.json",
  "title": "Phase 17 parallel language-pack candidate",
  "type": "object",
  "additionalProperties": false,
  "x-input-encoding": "UTF-8",
  "required": [
    "schemaVersion",
    "pack",
    "cards"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "languageCode"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "languageCode": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
        }
      }
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "content_card.schema.json"
      }
    }
  }
}
