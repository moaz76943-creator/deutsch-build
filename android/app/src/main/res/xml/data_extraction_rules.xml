<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path=".secure_session_credential" />
        <exclude domain="file" path=".secure_session_credential.tmp" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path=".secure_session_credential" />
        <exclude domain="file" path=".secure_session_credential.tmp" />
    </device-transfer>
</data-extraction-rules>
