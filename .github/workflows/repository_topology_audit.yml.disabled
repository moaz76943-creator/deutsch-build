# DISABLED 2026-10-25: manual duplicate outside the classified workflow set.
# Dispatch would spend private Actions minutes. The budgeted check is staging_self_check.yml.

name: "P0 Production Reachability & Stub Audit"

on:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  reachability-audit:
    runs-on: ubuntu-latest
    steps:
      - name: جلب مستودع البناء (deutsch-build)
        uses: actions/checkout@v7

      - name: إعداد بيئة بايثون
        uses: actions/setup-python@v7
        with:
          python-version: "3.11"

      - name: تتبع شجرة الوصول من main.dart وكشف الـ Stubs
        run: |
          cat << 'PYEOF' > reachability_audit.py
          import os, re, json

          LIB_DIR = "lib"

          # 1. جمع جميع ملفات Dart في المستودع
          all_dart_files = {}
          for root, _, files in os.walk(LIB_DIR):
              for file in files:
                  if file.endswith(".dart"):
                      rel_path = os.path.relpath(os.path.join(root, file), LIB_DIR).replace("\\", "/")
                      full_path = os.path.join(root, file)
                      with open(full_path, "r", encoding="utf-8", errors="ignore") as f:
                          all_dart_files[rel_path] = f.read()

          total_count = len(all_dart_files)

          # 2. تتبع مسار الوصول بدءاً من main.dart
          reachable = set()
          queue = ["main.dart"]

          while queue:
              current = queue.pop(0)
              if current not in all_dart_files or current in reachable:
                  continue
              reachable.add(current)

              content = all_dart_files[current]
              # البحث عن جميع استيرادات package أو الاستيرادات النسبية
              imports = re.findall(r"import\s+['\"]([^'\"]+)['\"]", content)
              for imp in imports:
                  target = None
                  if imp.startswith("package:"):
                      parts = imp.split("/", 1)
                      if len(parts) == 2:
                          target = parts[1]
                  elif not imp.startswith("dart:"):
                      base_dir = os.path.dirname(current)
                      target = os.path.normpath(os.path.join(base_dir, imp)).replace("\\", "/")

                  if target and target in all_dart_files and target not in reachable:
                      queue.append(target)

          unreachable = [f for f in all_dart_files if f not in reachable]

          # 3. فحص الدوال الفارغة والـ Stubs في جميع الملفات
          stubs_detected = []
          for rel_path, content in all_dart_files.items():
              lines = content.splitlines()
              # كشف دوال فارغة أو return افتراضي غير مكتمل
              if re.search(r"processReview\s*\([^)]*\)\s*\{\s*\}", content):
                  stubs_detected.append({"file": rel_path, "issue": "Empty processReview() stub"})
              if re.search(r"throw\s+UnimplementedError", content):
                  stubs_detected.append({"file": rel_path, "issue": "UnimplementedError stub"})
              if "lang_01" in content:
                  stubs_detected.append({"file": rel_path, "issue": "Fake lang_01 identifier used"})

          print("=" * 65)
          print("📊 تقرير فحص مسار الوصول وكشف المعمارية الصورية (Audit Report):")
          print("=" * 65)
          print(f"📁 إجمالي ملفات Dart المفحوصة: {total_count}")
          print(f"🔗 ملفات متصلة فعلياً وتبدأ من main.dart: {len(reachable)}")
          print(f"⚠️ ملفات معزولة تماماً لا يستدعيها التطبيق (Orphaned): {len(unreachable)}")
          print(f"🚨 حالات Stubs ودوال فارغة مكتشفة: {len(stubs_detected)}")
          print("=" * 65)

          if stubs_detected:
              print("\n[المخالفات والدوال الفارغة المكتشفة]:")
              for s in stubs_detected:
                  print(f"  - {s['file']}: {s['issue']}")

          print(f"\n[عينة من أول 10 ملفات معزولة لا تعمل في التطبيق]:")
          for u in unreachable[:10]:
              print(f"  - {u}")

          report = {
              "total_files": total_count,
              "reachable_count": len(reachable),
              "unreachable_count": len(unreachable),
              "stubs_count": len(stubs_detected),
              "stubs": stubs_detected,
              "unreachable_sample": unreachable[:30]
          }
          with open("reachability_report.json", "w", encoding="utf-8") as f:
              json.dump(report, f, indent=2, ensure_ascii=False)
          PYEOF
          python3 reachability_audit.py
