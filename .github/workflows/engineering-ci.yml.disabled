name: Engineering CI

on:
  push:
    branches: [main]
    paths-ignore:
      - 'docs/project-record/**'
  pull_request:
    branches: [main]

permissions:
  contents: read
  actions: none
  checks: none
  id-token: none
  pull-requests: none

concurrency:
  group: engineering-ci-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  python-gates:
    name: Python engineering gates
    if: github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository
    runs-on: ubuntu-latest
    timeout-minutes: 35
    steps:
      - name: Checkout exact PR head
        if: github.event_name == 'pull_request'
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          ref: ${{ github.event.pull_request.head.sha }}
          persist-credentials: false

      - name: Delegate PR regression ownership to Quality Gates
        if: github.event_name == 'pull_request'
        shell: bash
        run: |
          set -Eeuo pipefail
          echo "Quality Gates owns the canonical PR regression suite."
          echo "Engineering CI keeps this lightweight compatibility check to avoid duplicate runner work."

      - name: Checkout main source
        if: github.event_name != 'pull_request'
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          persist-credentials: false

      - name: Set up Python
        if: github.event_name != 'pull_request'
        uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5
        with:
          python-version: '3.12'

      - name: Read toolchain.lock
        if: github.event_name != 'pull_request'
        id: toolchain
        shell: bash
        run: |
          set -Eeuo pipefail
          source toolchain.lock
          printf 'flutter=%s\n' "$FLUTTER_VERSION" >> "$GITHUB_OUTPUT"
          printf 'java=%s\n' "$JAVA_MAJOR" >> "$GITHUB_OUTPUT"
          printf 'gradle=%s\n' "$GRADLE_VERSION" >> "$GITHUB_OUTPUT"

      - name: Set up Java
        if: github.event_name != 'pull_request'
        uses: actions/setup-java@b6effb05e454b25005698d916606bdc6ffcbf961 # v5
        with:
          distribution: temurin
          java-version: "${{ steps.toolchain.outputs.java }}"

      - name: Set up Gradle
        if: github.event_name != 'pull_request'
        uses: gradle/actions/setup-gradle@ed408507eac070d1f99cc633dbcf757c94c7933a # v4.4.3
        with:
          gradle-version: "${{ steps.toolchain.outputs.gradle }}"
          cache-disabled: true

      - name: Set up Flutter
        if: github.event_name != 'pull_request'
        uses: subosito/flutter-action@1a449444c387b1966244ae4d4f8c696479add0b2 # v2
        with:
          flutter-version: "${{ steps.toolchain.outputs.flutter }}"
          channel: stable
          cache: true
          pub-cache: true

      - name: Install Python test tooling
        if: github.event_name != 'pull_request'
        run: python3 -m pip install --disable-pip-version-check --no-input pytest

      - name: Run canonical quality gate
        if: github.event_name != 'pull_request'
        run: bash scripts/local_quality_gate.sh

  flutter-android:
    name: Flutter Android readiness
    needs: python-gates
    if: github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - name: Checkout exact PR head
        if: github.event_name == 'pull_request'
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          ref: ${{ github.event.pull_request.head.sha }}
          persist-credentials: false

      - name: Defer PR APK build until main
        if: github.event_name == 'pull_request'
        shell: bash
        run: |
          set -Eeuo pipefail
          echo "PR analysis/tests are owned by Quality Gates."
          echo "Android APK readiness runs once after integration on main."

      - name: Checkout main source
        if: github.event_name != 'pull_request'
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          persist-credentials: false

      - name: Read toolchain.lock
        if: github.event_name != 'pull_request'
        id: toolchain
        shell: bash
        run: |
          set -Eeuo pipefail
          source toolchain.lock
          printf 'flutter=%s\n' "$FLUTTER_VERSION" >> "$GITHUB_OUTPUT"
          printf 'java=%s\n' "$JAVA_MAJOR" >> "$GITHUB_OUTPUT"
          printf 'gradle=%s\n' "$GRADLE_VERSION" >> "$GITHUB_OUTPUT"

      - name: Set up Java
        if: github.event_name != 'pull_request'
        uses: actions/setup-java@b6effb05e454b25005698d916606bdc6ffcbf961 # v5
        with:
          distribution: temurin
          java-version: "${{ steps.toolchain.outputs.java }}"

      - name: Set up Gradle
        if: github.event_name != 'pull_request'
        uses: gradle/actions/setup-gradle@ed408507eac070d1f99cc633dbcf757c94c7933a # v4.4.3
        with:
          gradle-version: "${{ steps.toolchain.outputs.gradle }}"
          cache-disabled: false

      - name: Set up Flutter
        if: github.event_name != 'pull_request'
        uses: subosito/flutter-action@1a449444c387b1966244ae4d4f8c696479add0b2 # v2
        with:
          flutter-version: "${{ steps.toolchain.outputs.flutter }}"
          channel: stable
          cache: true
          pub-cache: true

      - name: Fetch locked Flutter dependencies
        if: github.event_name != 'pull_request'
        run: flutter pub get --enforce-lockfile

      - name: Materialize Flutter runtime content
        if: github.event_name != 'pull_request'
        run: python3 tool/content_compiler.py compile --output-dir lib/data/generated

      - name: Build Android debug APK
        if: github.event_name != 'pull_request'
        run: flutter build apk --debug --target-platform android-arm64

      - name: Upload debug APK artifact
        if: github.event_name != 'pull_request'
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
        with:
          name: engineering-debug-apk
          path: build/app/outputs/flutter-apk/app-debug.apk
          if-no-files-found: error
          retention-days: 3
