# DISABLED 2026-10-25: this workflow is outside the 30-workflow zero-billing contract.
# GitHub Actions cannot start ubuntu-latest jobs while billing is blocked
# (run 40148304805, job 121034297378: payments failed or spending limit reached).
# A billing failure is not a code failure and must not be required for merge.
# Canonical manual gates that remain: quality_gate_ci.yml, build.yml, build_apk.yml, build_aab.yml.
# Re-enable only by restoring a classified workflow that can actually run. Do not mark it green.

name: "AI Issue Triage"
on:
  issues:
    types: [opened]

permissions:
  issues: write

jobs:
  triage:
    runs-on: ubuntu-latest
    steps:
      - name: فرز وتصنيف المشكلة تلقائياً
        uses: actions/github-script@v7
        with:
          script: |
            const body = context.payload.issue.body || '';
            const labels = ['triage-needed'];
            if (body.includes('SQLite / SRS')) labels.push('area:sqlite');
            if (body.includes('Audio / Dispatcher')) labels.push('area:audio');
            if (body.includes('Core / Engine')) labels.push('area:core');
            if (body.includes('UI / Localization')) labels.push('area:ui');
            await github.rest.issues.addLabels({
              owner: context.repo.owner,
              repo: context.repo.repo,
              issue_number: context.payload.issue.number,
              labels: labels
            });
