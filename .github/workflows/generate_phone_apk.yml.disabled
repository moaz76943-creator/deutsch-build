# DISABLED 2026-10-25: this workflow is outside the 30-workflow zero-billing contract.
# GitHub Actions cannot start ubuntu-latest jobs while billing is blocked
# (run 40148304805, job 121034297378: payments failed or spending limit reached).
# A billing failure is not a code failure and must not be required for merge.
# Canonical manual gates that remain: quality_gate_ci.yml, build.yml, build_apk.yml, build_aab.yml.
# Re-enable only by restoring a classified workflow that can actually run. Do not mark it green.

name: "بناء وتنزيل الـ APK الآمن"

on:
  workflow_dispatch:

# تطبيق السياسة الأمنية الصارمة: منع السيرفر من حقن أو تعديل الأكواد
permissions:
  contents: read

jobs:
  build-apk:
    runs-on: ubuntu-latest
    steps:
      - name: جلب كود المستودع
        uses: actions/checkout@v7

      - name: إعداد بيئة جافا 17
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '17'

      - name: إعداد بيئة Flutter
        uses: subosito/flutter-action@v2
        with:
          channel: "stable"
          cache: true

      - name: تنظيف وتجهيز الحزم
        run: |
          flutter clean
          flutter pub get

      - name: بناء ملف التطبيق (نسخة تجريبية آمنة للتثبيت المباشر)
        run: flutter build apk --debug

      - name: رفع ملف التطبيق للتنزيل
        uses: actions/upload-artifact@v7
        with:
          name: Deutsch-App-Phone-Install
          path: build/app/outputs/flutter-apk/app-debug.apk
          retention-days: 7
