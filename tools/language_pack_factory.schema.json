{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deutsch-bilarabi.local/tools/language_pack_factory.schema.json",
  "title": "Language-neutral offline pack factory input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "pack",
    "requiredLocalizationKeys",
    "localization",
    "lexicon",
    "grammar"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "languageCode",
        "displayName",
        "version",
        "contractVersion",
        "textDirection"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
        },
        "languageCode": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "contractVersion": {
          "type": "string",
          "const": "1.0.0"
        },
        "textDirection": {
          "type": "string",
          "enum": [
            "ltr",
            "rtl"
          ]
        }
      }
    },
    "requiredLocalizationKeys": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "localization": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/directionalText"
      }
    },
    "lexicon": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "surface",
          "partOfSpeech",
          "direction"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "surface": {
            "type": "string",
            "minLength": 1
          },
          "partOfSpeech": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "type": "string",
            "enum": [
              "ltr",
              "rtl"
            ]
          },
          "bidiOverride": {
            "type": "boolean"
          },
          "fields": {
            "type": "object",
            "properties": {
              "canonical": {
                "$ref": "#/$defs/canonicalLexicalData"
              }
            },
            "additionalProperties": true
          }
        }
      }
    },
    "grammar": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "titleKey",
          "tree"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "titleKey": {
            "type": "string",
            "minLength": 1
          },
          "tree": {
            "$ref": "#/$defs/grammarNode"
          }
        }
      }
    }
  },
  "$defs": {
    "directionalText": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "direction"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "type": "string",
          "enum": [
            "ltr",
            "rtl"
          ]
        },
        "bidiOverride": {
          "type": "boolean"
        }
      }
    },
    "grammarNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "rule",
            "sequence",
            "choice",
            "token",
            "reference"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/grammarNode"
          }
        },
        "features": {
          "type": "object"
        }
      }
    },
    "canonicalLexicalData": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "senseId": {
          "type": "string",
          "minLength": 1
        },
        "register": {
          "type": "string",
          "enum": [
            "neutral",
            "formal",
            "informal",
            "colloquial",
            "written",
            "academic",
            "unknown"
          ]
        },
        "cefr": {
          "type": "string",
          "enum": [
            "unknown",
            "A1",
            "A2",
            "B1",
            "B2",
            "C1",
            "C2"
          ]
        },
        "semanticTags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "noun": {
          "$ref": "#/$defs/canonicalGermanNoun"
        },
        "verb": {
          "$ref": "#/$defs/canonicalGermanVerb"
        }
      }
    },
    "canonicalGermanNoun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gender",
        "declensionClass",
        "caseForms"
      ],
      "properties": {
        "gender": {
          "type": "string",
          "enum": [
            "masculine",
            "feminine",
            "neuter",
            "none",
            "unknown"
          ]
        },
        "plural": {
          "type": [
            "string",
            "null"
          ]
        },
        "declensionClass": {
          "type": "string",
          "enum": [
            "strong",
            "weak",
            "mixed",
            "irregular",
            "invariant",
            "unknown"
          ]
        },
        "caseForms": {
          "$ref": "#/$defs/germanNounCaseForms"
        }
      }
    },
    "germanNounCaseForms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nominativeSingular",
        "accusativeSingular",
        "dativeSingular",
        "genitiveSingular"
      ],
      "properties": {
        "nominativeSingular": {
          "type": "string",
          "minLength": 1
        },
        "accusativeSingular": {
          "type": "string",
          "minLength": 1
        },
        "dativeSingular": {
          "type": "string",
          "minLength": 1
        },
        "genitiveSingular": {
          "type": "string",
          "minLength": 1
        },
        "nominativePlural": {
          "type": [
            "string",
            "null"
          ]
        },
        "accusativePlural": {
          "type": [
            "string",
            "null"
          ]
        },
        "dativePlural": {
          "type": [
            "string",
            "null"
          ]
        },
        "genitivePlural": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "canonicalGermanVerb": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "infinitive",
        "reflexivity",
        "auxiliary"
      ],
      "properties": {
        "infinitive": {
          "type": "string",
          "minLength": 1
        },
        "separablePrefix": {
          "type": [
            "string",
            "null"
          ]
        },
        "inseparablePrefix": {
          "type": [
            "string",
            "null"
          ]
        },
        "reflexivity": {
          "type": "string",
          "enum": [
            "none",
            "accusative",
            "dative",
            "context_dependent",
            "unknown"
          ]
        },
        "auxiliary": {
          "type": "string",
          "enum": [
            "haben",
            "sein",
            "haben_or_sein",
            "unknown"
          ]
        },
        "participleII": {
          "type": [
            "string",
            "null"
          ]
        },
        "preterite": {
          "type": [
            "string",
            "null"
          ]
        },
        "imperative": {
          "type": [
            "string",
            "null"
          ]
        },
        "valencyFrames": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/verbValencyFrame"
          }
        },
        "forms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/germanVerbForm"
          }
        }
      }
    },
    "verbValencyFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "semanticRole"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "governedCase": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "nominative",
            "accusative",
            "dative",
            "genitive",
            null
          ]
        },
        "preposition": {
          "type": [
            "string",
            "null"
          ]
        },
        "prepositionCase": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "nominative",
            "accusative",
            "dative",
            "genitive",
            null
          ]
        },
        "semanticRole": {
          "type": "string",
          "minLength": 1
        },
        "objectRequired": {
          "type": "boolean"
        }
      }
    },
    "germanVerbForm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tense",
        "personKey",
        "form"
      ],
      "properties": {
        "tense": {
          "type": "string",
          "minLength": 1
        },
        "personKey": {
          "type": "string",
          "minLength": 1
        },
        "form": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
